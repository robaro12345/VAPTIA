# CampusHub Laboratory Configuration Template
# Copy to .env or choose .env.v1 / .env.v2
APP_VERSION=v1
NEXT_PUBLIC_API_VERSION=v1

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=campushub_lab_jwt_super_secret_key_v1_lab
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# When running locally without Docker: postgresql://campushub_user:campushub_pass@localhost:5432/campushub_db?schema=public
# When running inside Docker Compose: postgresql://campushub_user:campushub_pass@postgres:5432/campushub_db?schema=public
DATABASE_URL=postgresql://campushub_user:campushub_pass@postgres:5432/campushub_db?schema=public

# Storage Paths
STORAGE_DOCUMENTS_DIR=/app/storage/documents
STORAGE_UPLOADS_DIR=/app/storage/uploads
