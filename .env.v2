# CampusHub Laboratory Configuration - V2 (Security-Hardened Implementation)
APP_VERSION=v2
NEXT_PUBLIC_API_VERSION=v2

# Backend Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=campushub_lab_jwt_super_secret_key_v2_hardened_production
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Docker Compose network or local)
DATABASE_URL=postgresql://campushub_user:campushub_pass@postgres:5432/campushub_db?schema=public

# Storage Paths
STORAGE_DOCUMENTS_DIR=/app/storage/documents
STORAGE_UPLOADS_DIR=/app/storage/uploads
